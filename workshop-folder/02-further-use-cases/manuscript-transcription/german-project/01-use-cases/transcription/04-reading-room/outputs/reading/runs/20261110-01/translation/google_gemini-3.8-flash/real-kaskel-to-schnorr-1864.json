    "l14"
   ]
  },
  {
   "line_start": "l15",
   "line_end": "l18",
   "first_words": "Aber meinem verewigten",
   "last_words": "so zu hören!",
   "translation": "Yet to my late, great friend, alas, the good fortune was not granted to hear his Raoul thus!",
   "note": "",
   "segment_id": "s05",
   "verified": true,
   "lines": [
    "l15",
    "l16",
    "l17",
    "l18"
   ]
  },
  {
   "line_start": "l19",
   "line_end": "l19",
   "first_words": "Gott erhalte Sie!",
   "last_words": "Gott erhalte Sie!",
   "translation": "May God preserve you!",
   "note": "",
