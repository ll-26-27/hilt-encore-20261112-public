   ]
  },
  {
   "line_start": "l8",
   "line_end": "l14",
   "first_words": "Meine Freude wurde",
   "last_words": "da empfinden müßte!",
   "translation": "My joy was doubled when I caught sight of his so highly revered and likewise incomparable father among the audience, and told myself what he must be feeling at that moment!",
   "note": "",
   "segment_id": "s04",
   "verified": true,
   "lines": [
    "l8",
    "l9",
    "l10",
    "l11",
