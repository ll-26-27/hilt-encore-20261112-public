   ]
  },
  {
   "line_start": "l3",
   "line_end": "l8",
   "first_words": "So herrlich und",
   "last_words": "der Gegenwart ist.",
   "translation": "Never have I heard your so highly excellent son so magnificent and incomparable as yesterday in Meyerbeer's immortal work, although he is always the first tenor of the present day.",
   "note": "",
   "segment_id": "s03",
   "verified": true,
   "lines": [
