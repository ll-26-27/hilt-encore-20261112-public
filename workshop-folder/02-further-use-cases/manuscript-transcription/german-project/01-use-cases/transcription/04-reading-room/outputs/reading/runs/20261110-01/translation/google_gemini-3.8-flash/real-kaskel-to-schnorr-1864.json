   "line_start": "l2",
   "line_end": "l2",
   "first_words": "Hochgeehrter Freund!",
   "last_words": "Hochgeehrter Freund!",
   "translation": "Highly esteemed friend!",
   "note": "",
   "segment_id": "s02",
   "verified": true,
   "lines": [
