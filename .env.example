# Copy this file to .env (which is gitignored) and fill in only the keys you have.
# Run scripts with: node --env-file=.env ll-utilities/<folder>/<script>.mjs --help
# Never commit .env, paste a key into a chat, or share one.

# HUIT AI API gateways (Harvard). See _context/huit/ for how to get a key
# and which data levels each gateway is approved for.
HUIT_OPENAI_API_KEY=
HUIT_OPENAI_BASE_URL=
HUIT_GEMINI_API_KEY=
HUIT_GEMINI_BASE_URL=
HUIT_BEDROCK_API_KEY=
HUIT_BEDROCK_BASE_URL=

# External tools. NEVER send Level 3 data to these. See CLAUDE.md and _context/data-security/.
FAL_API_KEY=
OPENROUTER_API_KEY=
